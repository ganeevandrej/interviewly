generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model QuestionGroup {
  id          String  @id
  name        String
  accentColor String
  topics      Topic[]
  autoTag     Tag?    @relation("QuestionGroupAutoTag")
}

model Topic {
  id        String        @id
  groupId   String
  name      String
  isDefault Boolean       @default(false)
  group     QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  questions Question[]
  autoTag   Tag?          @relation("TopicAutoTag")

  @@index([groupId])
}

model Question {
  id       String          @id
  topicId  String
  question String
  answer   String
  position Int
  topic    Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  stories  StoryQuestion[]
  project  ProjectQuestion?

  @@index([topicId, position, id])
}

enum ProjectStatus {
  DRAFT
  READY
}

model Project {
  id               String             @id
  title            String
  color            String?
  description      String?
  team             Json?
  tasks            Json?
  responsibilities Json?
  achievements     Json?
  status           ProjectStatus      @default(DRAFT)
  technologies     ProjectTechnology[]
  questions        ProjectQuestion[]
  autoTag          Tag?               @relation("ProjectAutoTag")
}

model Technology {
  id       String              @id
  name     String              @unique
  projects ProjectTechnology[]
}

model ProjectTechnology {
  projectId    String
  technologyId String
  isFeatured   Boolean    @default(false)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
}

model ProjectQuestion {
  projectId  String
  questionId String   @unique
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([projectId, questionId])
  @@index([questionId])
}

model Story {
  id                  String          @id
  title               String
  context             String?
  problem             String?
  responsibility      String?
  solution            String?
  difficulties        String?
  learned             String?
  additionalQuestions String?
  tags                StoryTag[]
  questions           StoryQuestion[]
}

model Tag {
  id            String         @id
  name          String         @unique
  projectId     String?        @unique
  topicId       String?        @unique
  groupId       String?        @unique
  project       Project?       @relation("ProjectAutoTag", fields: [projectId], references: [id], onDelete: Cascade)
  topic         Topic?         @relation("TopicAutoTag", fields: [topicId], references: [id], onDelete: Cascade)
  questionGroup QuestionGroup? @relation("QuestionGroupAutoTag", fields: [groupId], references: [id], onDelete: Cascade)
  stories       StoryTag[]
}

model StoryTag {
  storyId String
  tagId   String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([storyId, tagId])
  @@index([tagId])
}

model StoryQuestion {
  storyId    String
  questionId String
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([storyId, questionId])
  @@index([questionId])
}
