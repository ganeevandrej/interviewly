generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String  @id
  name        String
  accentColor String
  topics      Topic[]
  questions   CategoryQuestion[]
  trainings   TrainingCategory[]
}

model Topic {
  id        String        @id
  categoryId String
  name      String
  category  Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions TopicQuestion[]
  tags      TopicTag[]
  trainings TrainingTopic[]

  @@index([categoryId])
}

model Question {
  id         String           @id
  question   String
  answer     String
  categories CategoryQuestion[]
  topics     TopicQuestion[]
  stories    StoryQuestion[]
  project    ProjectQuestion?
  trainings  TrainingQuestion[]
}

model CategoryQuestion {
  categoryId String
  questionId String   @unique
  position   Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([categoryId, questionId])
  @@index([categoryId, position, questionId])
}

model TopicQuestion {
  topicId    String
  questionId String   @unique
  position   Int
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([topicId, questionId])
  @@index([topicId, position, questionId])
}

enum ProjectStatus {
  DRAFT
  READY
}

model Project {
  id               String             @id
  title            String
  color            String?
  description      String?
  team             Json?
  tasks            Json?
  responsibilities Json?
  achievements     Json?
  status           ProjectStatus      @default(DRAFT)
  technologies     ProjectTechnology[]
  questions        ProjectQuestion[]
  tags             ProjectTag[]
}

model Technology {
  id       String              @id
  name     String              @unique
  projects ProjectTechnology[]
}

model ProjectTechnology {
  projectId    String
  technologyId String
  isFeatured   Boolean    @default(false)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
}

model ProjectQuestion {
  projectId  String
  questionId String   @unique
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([projectId, questionId])
  @@index([questionId])
}

model ProjectTag {
  projectId     String
  tagId         String
  isAutoCreated Boolean @default(false)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag           Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
}

model TopicTag {
  topicId       String
  tagId         String
  isAutoCreated Boolean @default(false)
  topic         Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  tag           Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([topicId, tagId])
  @@index([tagId])
}

model Story {
  id                  String          @id
  title               String
  context             String?
  problem             String?
  responsibility      String?
  solution            String?
  difficulties        String?
  learned             String?
  additionalQuestions String?
  tags                StoryTag[]
  questions           StoryQuestion[]
}

model Tag {
  id       String        @id
  name     String        @unique
  stories  StoryTag[]
  projects ProjectTag[]
  topics   TopicTag[]
}

model StoryTag {
  storyId String
  tagId   String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([storyId, tagId])
  @@index([tagId])
}

model StoryQuestion {
  storyId    String
  questionId String @unique
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([storyId, questionId])
  @@index([questionId])
}

enum TrainingStatus {
  IN_PROGRESS
  COMPLETED
}

enum TrainingType {
  MANUAL
  RANDOM
}

enum TrainingOrder {
  SEQUENTIAL
  RANDOM
}

enum TrainingQuestionStatus {
  IN_PROGRESS
  ACCEPTED
}

model Training {
  id                  String             @id
  name                String
  status              TrainingStatus     @default(IN_PROGRESS)
  type                TrainingType
  order               TrainingOrder
  questionLimit       Int?
  randomQuestionCount Int?
  categories          TrainingCategory[]
  topics              TrainingTopic[]
  questions           TrainingQuestion[]
}

model TrainingCategory {
  trainingId String
  categoryId String
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([trainingId, categoryId])
  @@index([categoryId])
}

model TrainingTopic {
  trainingId String
  topicId    String
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([trainingId, topicId])
  @@index([topicId])
}

model TrainingQuestion {
  trainingId String
  questionId String
  position   Int
  status     TrainingQuestionStatus @default(IN_PROGRESS)
  training   Training               @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  question   Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([trainingId, questionId])
  @@index([trainingId, position, questionId])
  @@index([questionId])
}
