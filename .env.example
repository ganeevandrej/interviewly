# Copy to .env.local. Use the PostgreSQL URI from Supabase > Connect.
# URL-encode special characters in the database password.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full"

# Direct connection or Session pooler for migrations.
# Required when DATABASE_URL uses the Transaction pooler (port 6543).
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full"
